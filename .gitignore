# Real configs and keys: never commit them, commit *.example.json instead.
server-config.json
client-config.json
connections.json
authorized_keys.json
*.key

# TLS cert of the server, made once with `go run ./cmd/gencert` and
# mounted into the container.
devcerts/

# Trust-on-first-use pin files (pin_file), local machine state.
*.pin

# Build output
*.exe
*.exe~
/server
/client
portprobe-linux

# cmd/tray's log
tray.log
tray.log.old
